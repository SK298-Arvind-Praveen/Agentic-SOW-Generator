    "process_story": {
      "steps": [
        {
          "id": "s1",
          "title": "Test clients connect",
          "description": "Approved test clients send HTTPS catalogue requests over the Site-to-Site VPN, which forwards them to the internal load balancer.",
          "node_ids": [
            "test_clients",
            "vpn",
            "alb"
          ],
          "edge_ids": [
            "e0",
            "e1"
          ],
          "flow_kind": "ingress"
        },
        {
          "id": "s2",
          "title": "Requests reach app nodes",
          "description": "The internal load balancer routes each request to a catalogue app node in either Availability Zone.",
          "node_ids": [
            "alb",
            "ec2_a",
            "ec2_b"
          ],
          "edge_ids": [
            "e2",
            "e3"
          ],
          "flow_kind": "runtime"
        },
        {
          "id": "s3",
          "title": "Catalogue data served",
          "description": "The app nodes query the RDS PostgreSQL primary, and the primary replicates synchronously to a standby in the other zone for failover.",
          "node_ids": [
            "ec2_a",
            "ec2_b",
            "rds_primary",
            "rds_standby"
          ],
          "edge_ids": [
            "e4",
            "e5",
            "e6"
          ],
          "flow_kind": "runtime"
        },
        {
          "id": "s4",
          "title": "Product images retrieved",
          "description": "The app reads product images from the private S3 media bucket through the S3 gateway endpoint.",
          "node_ids": [
            "ec2_a",
            "s3_gwep",
            "s3_media"
          ],
          "edge_ids": [
            "e8"
          ],
          "flow_kind": "retrieval"
        },
        {
          "id": "s5",
          "title": "Dependency calls made",
          "description": "The app calls the approved dependency test endpoints for the external services the catalogue relies on.",
          "node_ids": [
            "ec2_a",
            "test_endpoints"
          ],
          "edge_ids": [
            "e10"
          ],
          "flow_kind": "egress"
        },
        {
          "id": "s6",
          "title": "Catalogue database migrated",
          "description": "The migration runner pre-creates the schema on RDS, and DMS pulls a full load plus ongoing changes from the source PostgreSQL clone and applies them to RDS.",
          "node_ids": [
            "runner",
            "source_db",
            "dms",
            "rds_primary"
          ],
          "edge_ids": [
            "e18",
            "e16",
            "e17"
          ],
          "flow_kind": "migration"
        },
        {
          "id": "s7",
          "title": "Media files copied",
          "description": "DataSync copies media from the source media store and writes the objects into the S3 media bucket.",
          "node_ids": [
            "source_media",
            "datasync",
            "s3_media"
          ],
          "edge_ids": [
            "e19",
            "e20"
          ],
          "flow_kind": "migration"
        },
        {
          "id": "s8",
          "title": "Reconciliation evidence recorded",
          "description": "The migration runner writes ledger records through the S3 gateway endpoint to the evidence bucket so migration results can be audited.",
          "node_ids": [
            "runner",
            "s3_gwep",
            "s3_evidence"
          ],
          "edge_ids": [
            "e21",
            "e22"
          ],
          "flow_kind": "reporting"
        },
        {
          "id": "s9",
          "title": "Rollback changes captured",
          "description": "For a rollback, DMS captures target-only changes from RDS and writes them to S3, and the runner then applies that delta back to the source database.",
          "node_ids": [
            "rds_primary",
            "dms",
            "s3_gwep",
            "runner",
            "source_db"
          ],
          "edge_ids": [
            "e23",
            "e24",
            "e25"
          ],
          "flow_kind": "recovery"
        }
      ]
    },
